\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Qualitative segmentation results for a representative indoor scene with a clearly visible human subject. The ground-truth annotation is compared with the predictions produced by the evaluated architectures. PointNet exhibits a comparatively large number of false positive human predictions.}}{41}{figure.caption.30}\protected@file@percent }
\newlabel{fig:qualitative_normal}{{4.1}{41}{Qualitative segmentation results for a representative indoor scene with a clearly visible human subject. The ground-truth annotation is compared with the predictions produced by the evaluated architectures. PointNet exhibits a comparatively large number of false positive human predictions}{figure.caption.30}{}}
