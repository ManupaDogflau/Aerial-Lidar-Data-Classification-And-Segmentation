\centering
\caption{High-level taxonomy of LiDAR semantic segmentation approaches.}
\label{tab:lidar_taxonomy}
\begin{tabularx}{\textwidth}{|l|X|X|}
\hline
\textbf{Family} & \textbf{Core Idea} & \textbf{Representative Methods} \\
\hline
Point-based & Direct processing of raw point sets & PointNet, PointNet++, DGCNN \\
\hline
Voxel-based & Discretization into 3D grids & VoxelNet, SparseConvNet \\
\hline
Projection-based & Mapping 3D data to 2D representations & SalsaNet, 3D-MiniNet \\
\hline
Convolution-based & Local neighborhood aggregation in 3D & KPConv, ConvPoint, RandLA-Net \\
\hline
Transformer-based & Global context via attention mechanisms & Point Transformer, PTMF, 3DLST \\
\hline
Hybrid (SLAM + DL) & Integration of perception and localization & SLAM + segmentation pipelines \\
\hline
\end{tabularx}
\end{table}

